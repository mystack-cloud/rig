# Sample environment file for RIG project
# This file should be renamed to .env and populated with actual credentials

# Hetzner Cloud API Token
HETZNER_CLOUD_API_TOKEN="your-hetzner-cloud-token-here"

# Optional: Hetzner S3-Compatible Storage Endpoint
# S3_ENDPOINT_URL="https://fsn1.yourdomain.com"

# GitHub Personal Access Token for git clone operations
# Required for cloning private repositories or for higher rate limits
RIG_GITHUB_PAT="your-github-personal-access-token-here"